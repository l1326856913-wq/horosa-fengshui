    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@soul-atelier/core": "0.3.0",
    "tyme4ts": "1.4.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.14"
  }
}
