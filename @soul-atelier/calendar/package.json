    "农历",
    "四柱",
    "干支",
    "节气"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soul-atelier/sdks.git",
    "directory": "packages/calendar"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
